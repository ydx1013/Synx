{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "types": ["obsidian"],
    "noEmit": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "@synx/shared": ["../shared/src"],
      "@synx/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
